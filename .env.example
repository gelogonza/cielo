# Supabase Postgres connection string, used by Prisma (prisma.config.ts).
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL="postgresql://user:password@localhost:5432/cielo?schema=public"

# Supabase Auth, used by the client SDK for signup/login/OAuth/session refresh.
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Direct uploads (/api/save-image) go to Supabase Storage, not S3 — they need
# no extra credentials. The browser uploads with the user's own session, so the
# two NEXT_PUBLIC_ values above are the only thing involved. Create the bucket
# and its policies with prisma/manual-sql/009_item_images_bucket.sql.
