# Supabase Postgres connection string, used by Prisma (prisma.config.ts).
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL="postgresql://user:password@localhost:5432/cielo?schema=public"

# Supabase Auth, used by the client SDK for signup/login/OAuth/session refresh.
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# AWS S3, used by /api/save-image for presigned upload URLs (Tier 3 direct uploads).
# AWS IAM console -> create a least-privilege user scoped to this bucket only.
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="cielo-uploads"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
